{
  "$schema": "./tool-server-template/catalog.schema.json",
  "schemaVersion": "1.0.0",
  "name": "ashergarland-tool-servers",
  "scope": "curated-server-family",
  "servers": [
    {
      "id": "chatgpt-azure",
      "title": "Azure Operations",
      "description": "Safely inspect, diagnose, and perform constrained operations on Azure resources.",
      "version": "0.1.0",
      "repositoryUrl": "https://github.com/ashergarland/chatgpt-azure",
      "package": {
        "registry": "npm",
        "name": "chatgpt-azure",
        "url": "https://www.npmjs.com/package/chatgpt-azure",
        "transport": "stdio"
      },
      "remoteMcp": {
        "urlTemplate": "{PUBLIC_BASE_URL}/mcp",
        "transport": "streamable-http",
        "authentication": ["bearer-api-key", "x-api-key", "entra-jwt"]
      },
      "openapi": {
        "urlTemplate": "{PUBLIC_BASE_URL}/openapi.json"
      },
      "health": {
        "urlTemplate": "{PUBLIC_BASE_URL}/health",
        "status": "self-hosted"
      },
      "tools": [
        {
          "name": "azure_list_subscriptions",
          "summary": "List allowed Azure subscriptions.",
          "safety": "read-only"
        },
        {
          "name": "azure_list_resource_groups",
          "summary": "List resource groups in a subscription.",
          "safety": "read-only"
        },
        {
          "name": "azure_search_resources",
          "summary": "Search resources using structured filters.",
          "safety": "read-only"
        },
        {
          "name": "azure_get_resource",
          "summary": "Fetch a resource by ARM resource ID.",
          "safety": "read-only"
        },
        {
          "name": "azure_run_graph_query",
          "summary": "Run a validated read-only Resource Graph query.",
          "safety": "read-only"
        },
        {
          "name": "azure_get_activity_log",
          "summary": "Get recent Azure control-plane activity.",
          "safety": "read-only"
        },
        {
          "name": "azure_get_resource_metrics",
          "summary": "Get Azure Monitor resource metrics.",
          "safety": "read-only"
        },
        {
          "name": "azure_list_unhealthy_resources",
          "summary": "List unhealthy resources.",
          "safety": "read-only"
        },
        {
          "name": "azure_restart_virtual_machine",
          "summary": "Restart a virtual machine.",
          "safety": "mutation-gated"
        },
        {
          "name": "azure_start_virtual_machine",
          "summary": "Start a stopped virtual machine.",
          "safety": "mutation-gated"
        },
        {
          "name": "azure_restart_web_app",
          "summary": "Restart an App Service or Function App.",
          "safety": "mutation-gated"
        },
        {
          "name": "azure_tag_resource",
          "summary": "Merge tags onto a resource.",
          "safety": "mutation-gated"
        }
      ],
      "safety": {
        "leastPrivilegeByDefault": true,
        "scopeAllowlists": true,
        "mutationsDisabledByDefault": true,
        "explicitMutationConfirmation": true,
        "auditLogging": true,
        "credentialsPersisted": false
      }
    }
  ]
}

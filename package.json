{
  "name": "agent-tool-server-azure",
  "version": "0.2.0",
  "description": "Guard-railed Azure control plane for agents over HTTP/OpenAPI, stdio MCP and remote MCP.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/public.js",
  "types": "dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mcp:stdio": "node dist/stdio.js",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "metadata:validate": "agent-tool-validate-metadata --server server.json --package package.json",
    "deployment:validate": "node scripts/validate-deployment-contract.mjs",
    "deployment:conformance": "node scripts/run-deployment-conformance.mjs",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:live-deploy": "tsx scripts/live-deploy-verify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-server-azure.git"
  },
  "homepage": "https://github.com/ashergarland/agent-tool-server-azure#readme",
  "bugs": {
    "url": "https://github.com/ashergarland/agent-tool-server-azure/issues"
  },
  "dependencies": {
    "@agent-tool-platform/runtime": "0.1.3",
    "@azure/arm-appservice": "^19.0.0",
    "@azure/arm-compute": "^25.0.0",
    "@azure/arm-resourcegraph": "^5.0.0",
    "@azure/arm-resources": "^8.0.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-query": "^1.3.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agent-tool-platform/testkit": "0.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}

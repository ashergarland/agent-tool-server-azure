# ---- service ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-azure
SERVICE_VERSION=0.2.0
# Public URL advertised in the generated OpenAPI document. Required by ChatGPT.
# PUBLIC_BASE_URL=https://agent-tool-server-azure.example.com

REQUEST_TIMEOUT_MS=30000
# How long to let in-flight requests finish after SIGTERM.
SHUTDOWN_GRACE_MS=10000
# Bicep bundles are sent in the request body, so this is larger than a typical API.
HTTP_MAX_BODY_BYTES=4194304
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ---- caller authentication (agent -> server) -------------------------------
# This decides *who is calling*. It does not decide what they may do in Azure:
# ARM decides that, by evaluating the server's own managed identity.
# api-key | entra-jwt | disabled (disabled is rejected when NODE_ENV=production)
AUTH_MODE=api-key
# Comma separated. Each key must be >= 32 characters.
API_KEYS=replace-me-with-a-long-random-key-at-least-32-chars
# Only used when AUTH_MODE=entra-jwt
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=api://agent-tool-server-azure
# ENTRA_ALLOWED_APP_IDS=

# ---- Azure authentication (server -> Azure) --------------------------------
# Client id of the user-assigned managed identity used for reads and the four guarded
# operations. Omit locally to use your `az login` session.
# AZURE_CLIENT_ID=
# Client id of the SEPARATE user-assigned managed identity used only for deployments.
# Required in production when DEPLOYMENTS_ENABLED=true.
# AZURE_DEPLOYMENT_CLIENT_ID=
# AZURE_TENANT_ID=
AZURE_ARM_ENDPOINT=https://management.azure.com

# ---- blast radius ----------------------------------------------------------
# Empty means "everything the identity can already see". Set these in any real
# deployment. Deployments refuse to run without an explicit subscription allow-list.
AZURE_SUBSCRIPTION_IDS=
AZURE_ALLOWED_RESOURCE_GROUPS=
# Required before a management group scope deployment is possible at all.
AZURE_ALLOWED_MANAGEMENT_GROUP_IDS=
AZURE_TENANT_DEPLOYMENTS_ENABLED=false

# Ask ARM what each identity can actually do before reporting a subscription as
# readable or deployable. Turning this off makes azure_list_subscriptions faster and
# less honest.
AZURE_VERIFY_RBAC=true
AZURE_RBAC_CACHE_TTL_MS=300000

# ---- guarded operations ----------------------------------------------------
# State-changing tools are disabled by default; dry runs always work.
MUTATIONS_ENABLED=false
MUTATION_CONFIRMATION_REQUIRED=true

# ---- transports ------------------------------------------------------------
# Authenticated stateless Streamable HTTP MCP at /mcp.
MCP_HTTP_ENABLED=true

# ---- generic Bicep deployment ----------------------------------------------
# Off by default. Turning this on lets a caller deploy arbitrary (but heavily
# inspected) Bicep within the configured scopes, using the deployment identity.
DEPLOYMENTS_ENABLED=false

# Absolute path of the Bicep CLI installed in the image at build time. The server never
# downloads a compiler at runtime.
BICEP_CLI_PATH=/usr/local/bin/bicep
# Expected SHA-256 of that binary. Required when deployments run in production.
# Read it out of the image:
#   docker run --rm --entrypoint cat <image> /usr/local/share/bicep.sha256
# BICEP_CLI_SHA256=

BICEP_COMPILE_TIMEOUT_MS=60000
BICEP_MAX_OUTPUT_BYTES=8388608
BICEP_MAX_CONCURRENCY=2

# Bounds on a caller-supplied bundle.
BICEP_MAX_FILES=64
BICEP_MAX_FILE_BYTES=262144
BICEP_MAX_TOTAL_BYTES=1048576
BICEP_MAX_PATH_LENGTH=200
BICEP_MAX_PATH_DEPTH=8
BICEP_ALLOWED_EXTENSIONS=.bicep,.bicepparam,.json,.jsonc,.yaml,.yml,.txt,.md,.csv

# Bounds on the compiled ARM template.
BICEP_MAX_TEMPLATE_RESOURCES=500
BICEP_MAX_TEMPLATE_BYTES=4194304
BICEP_MAX_NESTED_DEPLOYMENTS=32
# Resource types refused in addition to deploymentScripts, which is never permitted.
BICEP_DENIED_RESOURCE_TYPES=microsoft.compute/virtualmachines/extensions,microsoft.compute/virtualmachinescalesets/extensions,microsoft.hybridcompute/machines/extensions,microsoft.connectedvmwarevsphere/virtualmachines/extensions

# Remote module restore is off by default. Enabling it lets the compiler reach the
# network; read docs/threat-model.md first.
BICEP_REMOTE_MODULES_ENABLED=false
BICEP_ALLOWED_REGISTRIES=
BICEP_TEMPLATE_SPECS_ENABLED=false

# Drop to this uid/gid when compiling. Only needed if the process runs as root; the
# published image already runs as a non-root user.
# BICEP_RUN_AS_UID=
# BICEP_RUN_AS_GID=

# ---- deployment records ----------------------------------------------------
# memory | azure-table. Production requires azure-table: in-memory records are lost
# when the app scales to zero and are not shared between replicas.
DEPLOYMENT_RECORD_STORE=memory
# DEPLOYMENT_RECORD_TABLE_ENDPOINT=https://<account>.table.core.windows.net/
DEPLOYMENT_RECORD_TABLE_NAME=deploymentrecords
DEPLOYMENT_LOCK_TABLE_NAME=deploymentlocks
DEPLOYMENT_LOCK_TTL_MS=900000

# How long a what-if preview, and the confirmation hash it produced, stay valid.
DEPLOYMENT_PREVIEW_TTL_MS=900000
DEPLOYMENT_MAX_PREVIEW_CHANGES=200
DEPLOYMENT_MAX_PROPERTY_CHANGES=20
DEPLOYMENT_MAX_OPERATIONS=100
DEPLOYMENT_WHATIF_TIMEOUT_MS=300000
DEPLOYMENT_POLL_INTERVAL_MS=5000
DEPLOYMENT_MAX_CONCURRENT=2

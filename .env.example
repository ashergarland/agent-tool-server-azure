# ---- service ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=chatgpt-azure
SERVICE_VERSION=0.1.0
# Public URL advertised in the generated OpenAPI document (required by ChatGPT).
# PUBLIC_BASE_URL=https://chatgpt-azure.example.com

REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ---- caller authentication (ChatGPT -> connector) --------------------------
# api-key | entra-jwt | disabled (disabled is rejected when NODE_ENV=production)
AUTH_MODE=api-key
# Comma separated. Each key must be >= 32 characters.
API_KEYS=replace-me-with-a-long-random-connector-key
# Only used when AUTH_MODE=entra-jwt
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=api://chatgpt-azure
# ENTRA_ALLOWED_APP_IDS=

# ---- Azure authentication (connector -> Azure) -----------------------------
# Client id of the user-assigned managed identity in Azure; omit locally to use `az login`.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
AZURE_ARM_ENDPOINT=https://management.azure.com

# ---- blast radius ----------------------------------------------------------
# Empty means "everything the identity can see"; set these in any real deployment.
AZURE_SUBSCRIPTION_IDS=
AZURE_ALLOWED_RESOURCE_GROUPS=

# State-changing tools are disabled by default; dry runs always work.
MUTATIONS_ENABLED=false
MUTATION_CONFIRMATION_REQUIRED=true
